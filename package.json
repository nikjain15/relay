{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay: advisor advice-to-action layer. Interview prototype, synthetic data only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "invariant:imports": "depcruise app components lib --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run invariant:imports && npm run data:check && npm run test",
    "data:build": "vite-node --config vitest.config.ts scripts/build-walkthrough.ts",
    "data:check": "vite-node --config vitest.config.ts scripts/build-walkthrough.ts -- --check",
    "e2e": "node scripts/e2e.mjs",
    "stress": "vite-node --config vitest.config.ts scripts/stress.tsx"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "playwright-core": "1.56.1",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite-node": "3.2.4",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
