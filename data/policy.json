{
  "_note": "Firm policy the engines read. Edit freely. The FINRA Rule 2210 threshold (25 retail investors) and window (30 days) are regulation and stay in lib/recipients/count.ts. Personalizable defaults (list size, signal weights, escalation days) live in data/profiles/firm.json. Servicing rules: first match wins, and money movement is checked first and always requires a callback (validate() fails otherwise). Its pattern errs toward flagging: a request that might move money is called back.",
  "triage": {
    "dismissReasons": [
      "Already discussed with client",
      "Not material for this household",
      "Wrong household attribute",
      "Timing not right"
    ]
  },
  "liquidity": {
    "cashProductId": "prod-mmf",
    "sleeveMaxRisk": 2,
    "sleeveMaxAccessDays": 30,
    "lockupDays": 90
  },
  "proposals": {
    "coreProductId": "prod-core-model"
  },
  "communications": {
    "disclosureDocId": "doc-disclosure"
  },
  "prospecting": {
    "warmth": {
      "existing": 3,
      "referral": 3,
      "event": 2,
      "signal": 1
    },
    "sizeBands": [
      {
        "minUsd": 10000000,
        "points": 2
      },
      {
        "minUsd": 1000000,
        "points": 1
      }
    ]
  },
  "servicing": {
    "rules": [
      {
        "pattern": "\\bwir(e|es|ed|ing)\\b|\\bach\\b|\\bbank (account|details)\\b|\\brouting number\\b|\\$[\\d.,]+\\s*(k|m|million|thousand)?\\b.*\\b(to|into)\\b|\\b(transfer\\w*|send|sent|move|moving|pay)\\b.*(\\bfunds\\b|\\bmoney\\b|\\bcash\\b|\\$[\\d.,]+|\\b\\d[\\d,.]*\\s*(k|m|dollars|thousand|million)\\b)",
        "kind": "Money movement",
        "route": "Advisor, then operations",
        "targetHours": 4,
        "callbackRequired": true
      },
      {
        "pattern": "beneficiar",
        "kind": "Beneficiary change",
        "route": "Client service associate",
        "targetHours": 48,
        "callbackRequired": false
      },
      {
        "pattern": "withdrawal|distribution",
        "kind": "Distribution set-up",
        "route": "Client service associate",
        "targetHours": 48,
        "callbackRequired": false
      },
      {
        "pattern": "pension|transfer value|move .* here",
        "kind": "Transfer in",
        "route": "Advisor and wealth strategist",
        "targetHours": 72,
        "callbackRequired": false
      },
      {
        "pattern": "tax document|statement",
        "kind": "Documents",
        "route": "Client service associate",
        "targetHours": 24,
        "callbackRequired": false
      },
      {
        "pattern": "address|phone number|email address",
        "kind": "Account details",
        "route": "Service team",
        "targetHours": 24,
        "callbackRequired": false
      }
    ],
    "default": {
      "kind": "Question",
      "route": "Advisor",
      "targetHours": 24,
      "callbackRequired": false
    }
  },
  "retrieval": {
    "_note": "Deterministic retrieval. corpusDay is today on the corpus clock (documents carry a publication day on the same clock). floor is the relevance below which a passage is not shown as evidence; topK caps what one screen shows; citedBoost is added when the opportunity record cites the document; stalePenalty multiplies a document past its review date. In production a model rewrites the query and reranks; the floor, the citation and the refusal stay in code.",
    "corpusDay": 60,
    "floor": 0.2,
    "topK": 6,
    "citedBoost": 0.25,
    "stalePenalty": 0.5,
    "reviewDueWithinDays": 14
  }
}
